{
  "manifest_version": 3,
  "name": "MinWinTidHelper",
  "version": "2.4.0",
  "description": "Fyll ut timer i minWINTID med ett klikk, med en ugle som hjelper deg.",
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "MinWinTidHelper-innstillinger",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": ["https://*.wintid.no/Maintenance"],
  "web_accessible_resources": [{
    "resources" : ["music/elevator.mp3"],
    "matches": ["<all_urls>"]
  }],
  "content_scripts": [
    {
      "matches": [
        "https://*.wintid.no/Maintenance"
      ],
      "js": ["owl.js", "content.js"],
      "css": ["styles.css"]
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
